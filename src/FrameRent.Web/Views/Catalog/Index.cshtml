@model IEnumerable<EquipmentResponseDto>
@{
    ViewData["Title"] = "Equipment Catalog";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Audiovisual Equipment Catalog</h1>
        <p class="text-muted mb-0">Explore cameras, lenses, lighting, audio, and stabilizers ready for your production.</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0 flex-wrap">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(selectedCategory) ? "btn-dark" : "btn-outline-secondary")">
            All Categories
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Index" asp-route-category="@cat"
               class="btn btn-sm @(string.Equals(selectedCategory, cat, StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary")">
                @cat
            </a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center">
        <i class="bi bi-camera-video-off display-4 text-muted mb-3"></i>
        <h5>No active equipment found</h5>
        <p class="text-muted mb-0">Please check back later or clear the category filter.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 card-equipment rounded-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary-subtle text-secondary-emphasis border">@item.Category</span>
                            <span class="text-success small fw-semibold">
                                <i class="bi bi-box-seam"></i> @item.TotalStock Total Units
                            </span>
                        </div>
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                        <hr class="my-3" />
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fs-4 fw-bold text-dark">$@item.DailyRate.ToString("F2")</span>
                                <span class="text-muted small">/ day</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning fw-semibold btn-sm px-3">
                                Check Availability & Rent <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
