@model IEnumerable<EquipmentResponseDto>
@{
    ViewData["Title"] = "Equipment Catalog & Gear Fleet";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@if (!isAuthenticated)
{
    <!-- ======================================================================= -->
    <!-- 1. FULL-WIDTH EDGE-TO-EDGE HERO LANDING PAGE (FOR GUEST / PUBLIC)       -->
    <!-- ======================================================================= -->
    <div class="w-100 py-5 py-lg-6 position-relative overflow-hidden mb-5 shadow-lg" 
         style="background: linear-gradient(135deg, #070a12 0%, #151b2e 50%, #2a113a 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <!-- Subtle Ambient Glow -->
        <div class="position-absolute top-0 end-0 translate-middle-y" style="width: 500px; height: 500px; background: radial-gradient(circle, rgba(245,158,11,0.18) 0%, transparent 70%); filter: blur(60px); pointer-events: none;"></div>

        <div class="container-fluid px-4 px-lg-5 position-relative" style="z-index: 2;">
            <div class="row align-items-center g-5">
                <div class="col-lg-7 text-white">
                    <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3 shadow-sm d-inline-flex align-items-center gap-1">
                        <i class="bi bi-stars"></i> Cinema Gear Fleet for Creators & Studios
                    </span>
                    <h1 class="display-3 fw-bolder tracking-tight mb-4 text-white">
                        Rent Cinema-Grade Audiovisual Gear, <span class="text-warning">Friction-Free.</span>
                    </h1>
                    <p class="lead text-white-50 mb-5 pe-lg-5 fs-5">
                        Say goodbye to broken spreadsheets and WhatsApp chat chaos. Verify live fleet inventory by dates, lock in guaranteed units, and power your production with industry-standard cameras, lighting, and audio.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="#catalog-section" class="btn btn-warning btn-lg fw-bold rounded-pill px-4 text-dark shadow d-inline-flex align-items-center gap-2">
                            <i class="bi bi-camera-reels-fill"></i> Explore Available Fleet
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg rounded-pill px-4 page-link-trigger d-inline-flex align-items-center gap-2">
                            <i class="bi bi-person-plus-fill"></i> Create Free Account
                        </a>
                    </div>
                </div>

                <!-- DYNAMIC PRODUCT SHOWCASE CAROUSEL (WITH LIVE SPECIAL DISCOUNTS) -->
                <div class="col-lg-5">
                    <div id="dynamicGearCarousel" class="carousel slide carousel-fade shadow-2xl rounded-4 overflow-hidden border border-white border-opacity-15" data-bs-ride="carousel" data-bs-interval="3500">
                        <div class="carousel-inner" style="background: #0b1120;">
                            <!-- Slide 1: Sony FX3 -->
                            <div class="carousel-item active">
                                <div class="position-relative" style="height: 380px;">
                                    <img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=800&q=80" 
                                         class="d-block w-100 h-100" style="object-fit: cover;" alt="Sony FX3 Cinema">
                                    <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                                        <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold shadow">
                                            <i class="bi bi-fire me-1"></i> 25% OFF Weekend Pack
                                        </span>
                                        <span class="badge bg-dark bg-opacity-75 text-warning px-3 py-1 rounded-pill small">
                                            Popular Cinema Choice
                                        </span>
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 end-0 p-4 text-white" 
                                         style="background: linear-gradient(180deg, transparent 0%, rgba(9, 13, 22, 0.95) 100%);">
                                        <div class="d-flex justify-content-between align-items-end">
                                            <div>
                                                <h4 class="fw-bold mb-1">Sony FX3 Cinema Camera</h4>
                                                <div class="small text-white-50">4K 120p &bull; Dual Base ISO &bull; S-Cinetone</div>
                                            </div>
                                            <div class="text-end">
                                                <span class="text-white-50 text-decoration-line-through small d-block">$160.00</span>
                                                <span class="fs-4 fw-extrabold text-warning">$120.00<span class="fs-6 text-white-50">/day</span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2: Canon RF Lens -->
                            <div class="carousel-item">
                                <div class="position-relative" style="height: 380px;">
                                    <img src="https://images.unsplash.com/photo-1617005082133-548c4dd27f35?auto=format&fit=crop&w=800&q=80" 
                                         class="d-block w-100 h-100" style="object-fit: cover;" alt="Canon RF Lens">
                                    <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                                        <span class="badge bg-success px-3 py-2 rounded-pill fw-bold shadow">
                                            <i class="bi bi-stars me-1"></i> Promo Bundle: Save 20%
                                        </span>
                                        <span class="badge bg-dark bg-opacity-75 text-info px-3 py-1 rounded-pill small">
                                            Prime Cinema Glass
                                        </span>
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 end-0 p-4 text-white" 
                                         style="background: linear-gradient(180deg, transparent 0%, rgba(9, 13, 22, 0.95) 100%);">
                                        <div class="d-flex justify-content-between align-items-end">
                                            <div>
                                                <h4 class="fw-bold mb-1">Canon RF 24-70mm f/2.8L</h4>
                                                <div class="small text-white-50">Optical IS &bull; Constant f/2.8 &bull; Weather Sealed</div>
                                            </div>
                                            <div class="text-end">
                                                <span class="text-white-50 text-decoration-line-through small d-block">$55.00</span>
                                                <span class="fs-4 fw-extrabold text-warning">$45.00<span class="fs-6 text-white-50">/day</span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Studio Lighting Aputure -->
                            <div class="carousel-item">
                                <div class="position-relative" style="height: 380px;">
                                    <img src="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=800&q=80" 
                                         class="d-block w-100 h-100" style="object-fit: cover;" alt="Aputure Studio Lighting">
                                    <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold shadow">
                                            <i class="bi bi-lightning-charge-fill me-1"></i> Special Shoot Bundle
                                        </span>
                                        <span class="badge bg-dark bg-opacity-75 text-warning px-3 py-1 rounded-pill small">
                                            Studio & Location Kit
                                        </span>
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 end-0 p-4 text-white" 
                                         style="background: linear-gradient(180deg, transparent 0%, rgba(9, 13, 22, 0.95) 100%);">
                                        <div class="d-flex justify-content-between align-items-end">
                                            <div>
                                                <h4 class="fw-bold mb-1">Aputure Light Storm 300d II</h4>
                                                <div class="small text-white-50">350W COB LED &bull; Bowens Mount &bull; Wireless Control</div>
                                            </div>
                                            <div class="text-end">
                                                <span class="text-white-50 text-decoration-line-through small d-block">$70.00</span>
                                                <span class="fs-4 fw-extrabold text-warning">$55.00<span class="fs-6 text-white-50">/day</span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 4: DJI RS 3 Pro Gimbal -->
                            <div class="carousel-item">
                                <div class="position-relative" style="height: 380px;">
                                    <img src="https://images.unsplash.com/photo-1527011046414-4781f1f94f8c?auto=format&fit=crop&w=800&q=80" 
                                         class="d-block w-100 h-100" style="object-fit: cover;" alt="DJI RS 3 Pro Gimbal">
                                    <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                                        <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold shadow">
                                            <i class="bi bi-award-fill me-1"></i> Filmmaker Favorite
                                        </span>
                                        <span class="badge bg-dark bg-opacity-75 text-info px-3 py-1 rounded-pill small">
                                            3-Axis Carbon Stabilizer
                                        </span>
                                    </div>
                                    <div class="position-absolute bottom-0 start-0 end-0 p-4 text-white" 
                                         style="background: linear-gradient(180deg, transparent 0%, rgba(9, 13, 22, 0.95) 100%);">
                                        <div class="d-flex justify-content-between align-items-end">
                                            <div>
                                                <h4 class="fw-bold mb-1">DJI RS 3 Pro Gimbal</h4>
                                                <div class="small text-white-50">4.5kg Payload &bull; Automated Axis Locks &bull; LiDAR Ready</div>
                                            </div>
                                            <div class="text-end">
                                                <span class="text-white-50 text-decoration-line-through small d-block">$65.00</span>
                                                <span class="fs-4 fw-extrabold text-warning">$50.00<span class="fs-6 text-white-50">/day</span></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Carousel Controls -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#dynamicGearCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon rounded-circle p-2 bg-dark bg-opacity-50" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#dynamicGearCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon rounded-circle p-2 bg-dark bg-opacity-50" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- ======================================================================= -->
    <!-- 2. FULL-WIDTH EDGE-TO-EDGE CUSTOMER DASHBOARD (WHEN LOGGED IN)          -->
    <!-- ======================================================================= -->
    <div class="w-100 py-5 position-relative overflow-hidden mb-5 shadow-sm" 
         style="background: linear-gradient(135deg, #090e1a 0%, #172033 60%, #1e293b 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="container-fluid px-4 px-lg-5 position-relative" style="z-index: 2;">
            <div class="row align-items-center g-4">
                <div class="col-lg-8 text-white">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-semibold">
                            <i class="bi bi-shield-check me-1"></i> Verified Customer Space
                        </span>
                        <span class="text-white-50 small">&bull; Ready to book</span>
                    </div>
                    <h2 class="display-5 fw-bold mb-2">Welcome Back, @User.Identity?.Name 👋</h2>
                    <p class="text-white-50 fs-5 mb-4 pe-lg-4">
                        Plan and secure audiovisual equipment for your upcoming film, video shoot, or broadcast. Check real-time date availability below or view your active reservations.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#catalog-section" class="btn btn-warning fw-bold rounded-pill px-4 text-dark shadow-sm">
                            <i class="bi bi-search me-1"></i> Book Equipment
                        </a>
                        @if (User.IsInRole(Roles.Customer))
                        {
                            <a asp-controller="Rentals" asp-action="MyRentals" class="btn btn-outline-light rounded-pill px-4 page-link-trigger">
                                <i class="bi bi-calendar-check-fill me-1 text-warning"></i> View My Rentals
                            </a>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="p-4 rounded-4 shadow-sm" style="background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-white small text-uppercase tracking-wider">Rental Policy Notice</span>
                            <i class="bi bi-info-circle-fill text-warning"></i>
                        </div>
                        <p class="text-white-50 small mb-0">
                            You may have up to <strong>3 active rentals</strong> (Pending/Approved) simultaneously. Automatic late fees apply if equipment is returned after the agreed end date.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ======================================================================= -->
<!-- CATALOG FILTER & GEAR FLEET GRID (IN FLUID CONTAINER)                   -->
<!-- ======================================================================= -->
<div id="catalog-section" class="container-fluid px-4 px-lg-5 pt-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-sliders text-warning"></i> Equipment Catalog
            </h3>
            <p class="text-muted small mb-0">Select any camera, lens, lighting, or accessory to check units and reserve your dates.</p>
        </div>

        <!-- Category Filter Pills -->
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(selectedCategory) ? "btn-warning text-dark fw-bold shadow-sm" : "btn-outline-secondary")">
                All Equipment
            </a>
            @foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-category="@cat"
                   class="btn btn-sm rounded-pill px-3 @(string.Equals(selectedCategory, cat, StringComparison.OrdinalIgnoreCase) ? "btn-warning text-dark fw-bold shadow-sm" : "btn-outline-secondary")">
                    @cat
                </a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 my-4">
            <i class="bi bi-camera-video-off display-4 text-muted mb-3"></i>
            <h5 class="fw-bold">No active gear in this category</h5>
            <p class="text-muted mb-3">Try clearing the category filter to explore other available equipment.</p>
            <div>
                <a asp-action="Index" class="btn btn-dark btn-sm rounded-pill px-3 page-link-trigger">View All Equipment</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var gearImg = EquipmentImageHelper.GetImageUrl(item.Category, item.Name);

                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="gear-card h-100 d-flex flex-column shadow-sm">
                        <!-- Product Image Box -->
                        <div class="gear-img-wrap">
                            <img src="@gearImg" alt="@item.Name" loading="lazy" />
                            <span class="badge-category">
                                <i class="bi bi-tag-fill me-1 text-warning"></i> @item.Category
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Available for Rent
                                </span>
                            </div>

                            <h5 class="fw-bold mb-2">@item.Name</h5>
                            <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>

                            <hr class="my-3 opacity-25" />

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fs-4 fw-extrabold text-warning">$@item.DailyRate.ToString("F2")</span>
                                    <span class="text-muted small">/day</span>
                                </div>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-rent px-3 py-2 small shadow-sm d-flex align-items-center gap-1 page-link-trigger">
                                    <span>Check & Rent</span>
                                    <i class="bi bi-chevron-right fs-6"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
