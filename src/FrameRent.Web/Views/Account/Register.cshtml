@model RegisterViewModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="p-2 rounded-3 bg-warning text-dark d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-person-badge-fill fs-4"></i>
                </span>
                <h3 class="fw-bold mb-1 text-dark">Create Account</h3>
                <p class="text-muted small">Sign up as a customer to start booking audiovisual gear.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="creator@studio.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Min 6 chars, upper, lower & digit" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-check"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Repeat password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-warning w-100 fw-bold py-3 rounded-pill text-dark shadow-sm">
                    Complete Registration
                </button>
            </form>

            <hr class="my-4 text-muted opacity-25" />
            <p class="text-center small mb-0 text-muted">
                Already registered? <a asp-action="Login" class="fw-bold text-dark text-decoration-none">Sign In</a>
            </p>
        </div>
    </div>
</div>
