@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-sm-10 col-md-6 col-lg-4 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center gear-card" style="backdrop-filter: blur(10px);">
            <!-- Minimalist Brand Header -->
            <div class="mb-4">
                <span class="p-2 rounded-3 bg-warning text-dark d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 44px; height: 44px;">
                    <i class="bi bi-camera-reels-fill fs-5"></i>
                </span>
                <h4 class="fw-bold mb-1">Sign In</h4>
                <p class="text-muted small mb-0">Enter your credentials to continue</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 mb-3 text-start"></div>

            <form asp-action="Login" method="post" id="loginForm">
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label small fw-semibold text-muted mb-1"></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-body-tertiary border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 ps-1" placeholder="you@studio.com" autofocus required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4 text-start">
                    <label asp-for="Password" class="form-label small fw-semibold text-muted mb-1"></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-body-tertiary border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control border-start-0 ps-1" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark shadow-sm">
                    Continue
                </button>
            </form>

            <div class="mt-4 pt-2 border-top opacity-75">
                <p class="small text-muted mb-0">
                    New here? <a asp-action="Register" class="fw-bold text-warning text-decoration-none page-link-trigger">Create Account</a>
                </p>
            </div>
        </div>
    </div>
</div>
