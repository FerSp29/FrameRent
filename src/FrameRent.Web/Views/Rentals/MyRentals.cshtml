@model IEnumerable<RentalResponseDto>
@{
    ViewData["Title"] = "My Rentals & Reservations";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-calendar-check text-warning"></i> My Equipment Rentals
        </h2>
        <p class="text-muted small mb-0">Track all your equipment bookings, pickup dates, return statuses, and invoices.</p>
    </div>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning fw-bold text-dark rounded-pill px-4 btn-sm shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> New Rental
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center rounded-4">
        <div class="p-4 rounded-circle bg-light d-inline-flex mx-auto mb-3" style="width: 80px; height: 80px; align-items: center; justify-content: center;">
            <i class="bi bi-bag-x fs-1 text-muted"></i>
        </div>
        <h4 class="fw-bold text-dark">No Rentals Booked Yet</h4>
        <p class="text-muted small mb-4">Explore our inventory of cameras, lenses, lights, and accessories for your next production.</p>
        <div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-semibold">
                Browse Gear Fleet
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Equipment</th>
                        <th>Dates & Duration</th>
                        <th>Quantity</th>
                        <th>Total Cost</th>
                        <th>Late Fee</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        var gearImg = EquipmentImageHelper.GetImageUrl(rental.EquipmentCategory, rental.EquipmentName);
                        var badgeClass = rental.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Approved" => "bg-primary text-white",
                            "Delivered" => "bg-info text-dark",
                            "Returned" => "bg-success text-white",
                            "Rejected" => "bg-danger text-white",
                            "Cancelled" => "bg-secondary text-white",
                            _ => "bg-dark"
                        };

                        bool canCancel = (rental.Status == "Pending" || rental.Status == "Approved") && today < rental.StartDate;

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@gearImg" alt="@rental.EquipmentName" class="rounded-3 shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-bold text-dark">@rental.EquipmentName</div>
                                        <div class="small text-muted">@rental.EquipmentCategory &bull; $@rental.DailyRate.ToString("F2")/day</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@rental.StartDate.ToString("yyyy-MM-dd") &rarr; @rental.EndDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted"><i class="bi bi-clock me-1"></i>@rental.TotalDays day(s)</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@rental.Quantity unit(s)</span>
                            </td>
                            <td class="fw-bold text-dark fs-6">$@rental.TotalCost.ToString("F2")</td>
                            <td>
                                @if (rental.LateFee > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">+$@rental.LateFee.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">$0.00</span>
                                }
                            </td>
                            <td>
                                <span class="badge @badgeClass rounded-pill px-3 py-2 fw-bold">@rental.Status</span>
                                @if (rental.ActualReturnDate.HasValue)
                                {
                                    <div class="small text-muted mt-1"><i class="bi bi-arrow-return-left me-1"></i>@rental.ActualReturnDate.Value.ToString("yyyy-MM-dd")</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (canCancel)
                                {
                                    <form asp-action="Cancel" asp-route-id="@rental.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to cancel this rental reservation?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
