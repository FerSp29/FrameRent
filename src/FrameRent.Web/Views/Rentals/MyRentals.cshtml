@model IEnumerable<RentalResponseDto>
@{
    ViewData["Title"] = "My Rentals & Reservations";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-calendar-check text-warning"></i> My Equipment Rentals
        </h2>
        <p class="text-muted small mb-0">Track all your equipment bookings, pickup dates, return statuses, and invoices.</p>
    </div>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning fw-bold text-dark rounded-pill px-4 btn-sm shadow-sm page-link-trigger">
        <i class="bi bi-plus-lg me-1"></i> New Rental
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center rounded-4 gear-card">
        <div class="p-4 rounded-circle bg-body-tertiary d-inline-flex mx-auto mb-3" style="width: 80px; height: 80px; align-items: center; justify-content: center;">
            <i class="bi bi-bag-x fs-1 text-muted"></i>
        </div>
        <h4 class="fw-bold">No Rentals Booked Yet</h4>
        <p class="text-muted small mb-4">Explore our inventory of cameras, lenses, lights, and accessories for your next production.</p>
        <div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-semibold page-link-trigger">
                Browse Gear Fleet
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden gear-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Equipment</th>
                        <th>Dates & Duration</th>
                        <th>Quantity</th>
                        <th>Total Cost</th>
                        <th>Late Fee</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        var gearImg = EquipmentImageHelper.GetImageUrl(rental.EquipmentCategory, rental.EquipmentName);
                        var badgeClass = rental.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Approved" => "bg-primary text-white",
                            "Delivered" => "bg-info text-dark",
                            "Returned" => "bg-success text-white",
                            "Rejected" => "bg-danger text-white",
                            "Cancelled" => "bg-secondary text-white",
                            _ => "bg-dark"
                        };

                        bool canCancel = (rental.Status == "Pending" || rental.Status == "Approved") && today < rental.StartDate;

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@gearImg" alt="@rental.EquipmentName" class="rounded-3 shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-bold">@rental.EquipmentName</div>
                                        <div class="small text-muted">@rental.EquipmentCategory &bull; $@rental.DailyRate.ToString("F2")/day</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@rental.StartDate.ToString("yyyy-MM-dd") &rarr; @rental.EndDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted"><i class="bi bi-clock me-1"></i>@rental.TotalDays day(s)</div>
                            </td>
                            <td>
                                <span class="badge bg-body-tertiary text-body border px-2 py-1">@rental.Quantity unit(s)</span>
                            </td>
                            <td class="fw-bold fs-6">$@rental.TotalCost.ToString("F2")</td>
                            <td>
                                @if (rental.LateFee > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">+$@rental.LateFee.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">$0.00</span>
                                }
                            </td>
                            <td>
                                <span class="badge @badgeClass rounded-pill px-3 py-2 fw-bold">@rental.Status</span>
                                @if (rental.ActualReturnDate.HasValue)
                                {
                                    <div class="small text-muted mt-1"><i class="bi bi-arrow-return-left me-1"></i>@rental.ActualReturnDate.Value.ToString("yyyy-MM-dd")</div>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (canCancel)
                                {
                                    <!-- Simple, rock-solid cancellation form with inline styled confirm dialog -->
                                    <form asp-action="Cancel" asp-route-id="@rental.Id" method="post" class="d-inline cancel-rental-form"
                                          data-equipment-name="@rental.EquipmentName">
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold trigger-cancel-btn">
                                            <i class="bi bi-x-circle me-1"></i> Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Single Global Clean In-App Cancellation Modal (Placed outside table to prevent z-index/clipping bugs) -->
<div class="modal fade" id="globalCancelModal" tabindex="-1" aria-labelledby="globalCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-2xl p-3 gear-card">
            <div class="modal-header border-0 pb-0">
                <div class="p-2 rounded-circle bg-danger bg-opacity-10 text-danger me-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                </div>
                <h5 class="modal-title fw-bold" id="globalCancelModalLabel">Cancel Equipment Reservation?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-start py-3 text-muted small">
                Are you sure you want to cancel the reservation for <strong class="text-body" id="modalEquipNameText"></strong>?
                <div class="mt-2 p-3 rounded-3 bg-body-tertiary border text-body">
                    <i class="bi bi-info-circle text-warning me-1"></i> Your reserved stock units will be released back to the fleet immediately.
                </div>
                <div class="mt-2 text-danger">This cancellation cannot be undone.</div>
            </div>
            <div class="modal-footer border-0 pt-0 d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Keep Booking</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 btn-sm fw-bold" id="confirmCancelSubmitBtn">
                    Yes, Cancel Rental
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Bulletproof In-App Modal Handler for Cancellations
    document.addEventListener('DOMContentLoaded', () => {
        let activeFormToSubmit = null;
        const modalElement = document.getElementById('globalCancelModal');
        const modalEquipText = document.getElementById('modalEquipNameText');
        const confirmBtn = document.getElementById('confirmCancelSubmitBtn');
        const bsModal = modalElement ? new bootstrap.Modal(modalElement) : null;

        document.querySelectorAll('.cancel-rental-form .trigger-cancel-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                const form = btn.closest('.cancel-rental-form');
                const equipName = form?.getAttribute('data-equipment-name') || 'this equipment';
                
                activeFormToSubmit = form;
                if (modalEquipText) modalEquipText.textContent = equipName;

                if (bsModal) {
                    bsModal.show();
                }
            });
        });

        if (confirmBtn) {
            confirmBtn.addEventListener('click', () => {
                if (activeFormToSubmit) {
                    // Trigger loader before submission
                    const loader = document.getElementById('page-loader-overlay');
                    if (loader) loader.classList.add('active');

                    if (bsModal) bsModal.hide();
                    activeFormToSubmit.submit();
                }
            });
        }
    });
</script>
