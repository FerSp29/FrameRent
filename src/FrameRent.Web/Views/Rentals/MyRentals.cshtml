@model IEnumerable<RentalResponseDto>
@{
    ViewData["Title"] = "Mis Pedidos y Alquileres";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var rentalList = Model.ToList();
    
    // KPI Metrics calculation
    int totalRentals = rentalList.Count;
    int activeRentals = rentalList.Count(r => r.Status == "Pending" || r.Status == "Approved");
    int inProductionRentals = rentalList.Count(r => r.Status == "Delivered");
    int completedRentals = rentalList.Count(r => r.Status == "Returned");
    decimal totalSpent = rentalList.Where(r => r.Status != "Cancelled" && r.Status != "Rejected").Sum(r => r.TotalCost + r.LateFee);
}

<div class="container-fluid px-4 px-lg-5 py-3">
    <!-- Header Title & Quick Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="p-2 rounded-3 bg-warning text-dark d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                    <i class="bi bi-bag-check-fill fs-5"></i>
                </span>
                <h2 class="fw-bold mb-0">Mis Pedidos & Alquileres</h2>
            </div>
            <p class="text-muted small mb-0">
                Supervisa el estado de tus reservas, fechas de rodaje, devoluciones y gestiona la cancelación de pedidos elegibles.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm page-link-trigger">
                <i class="bi bi-plus-circle me-1"></i> Nueva Reserva
            </a>
        </div>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 gear-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Total Reservas</div>
                        <div class="fs-3 fw-bold text-body">@totalRentals</div>
                    </div>
                    <div class="p-3 rounded-circle bg-body-tertiary text-warning">
                        <i class="bi bi-collection-play-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 gear-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Activas / En Revisión</div>
                        <div class="fs-3 fw-bold text-warning">@activeRentals</div>
                    </div>
                    <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 gear-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">En Rodaje / Entrega</div>
                        <div class="fs-3 fw-bold text-info">@inProductionRentals</div>
                    </div>
                    <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info">
                        <i class="bi bi-camera-reels-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 gear-card h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Inversión Total</div>
                        <div class="fs-3 fw-bold text-success">$@totalSpent.ToString("F2")</div>
                    </div>
                    <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!rentalList.Any())
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 gear-card">
            <div class="p-4 rounded-circle bg-body-tertiary d-inline-flex mx-auto mb-3" style="width: 85px; height: 85px; align-items: center; justify-content: center;">
                <i class="bi bi-bag-x fs-1 text-muted"></i>
            </div>
            <h4 class="fw-bold mb-2">Aún no tienes pedidos registrados</h4>
            <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
                Explora nuestra flota de cámaras de cine, lentes profesionales, iluminación y estabilizadores listos para tu próxima producción audiovisual.
            </p>
            <div>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm page-link-trigger">
                    <i class="bi bi-camera-fill me-1"></i> Explorar Catálogo
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Interactive Filter Tabs -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div class="btn-group p-1 bg-body-tertiary rounded-pill shadow-sm" role="group" id="rentalFilterGroup">
                <button type="button" class="btn btn-sm rounded-pill fw-semibold active px-3 filter-btn" data-filter="all">
                    Todos (@totalRentals)
                </button>
                <button type="button" class="btn btn-sm rounded-pill fw-semibold px-3 filter-btn" data-filter="active">
                    Activos (@activeRentals)
                </button>
                <button type="button" class="btn btn-sm rounded-pill fw-semibold px-3 filter-btn" data-filter="delivered">
                    En Uso (@inProductionRentals)
                </button>
                <button type="button" class="btn btn-sm rounded-pill fw-semibold px-3 filter-btn" data-filter="completed">
                    Devueltos (@completedRentals)
                </button>
                <button type="button" class="btn btn-sm rounded-pill fw-semibold px-3 filter-btn" data-filter="cancelled">
                    Cancelados / Otros
                </button>
            </div>
            
            <div class="text-muted small d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-warning"></i>
                <span>Las cancelaciones están permitidas hasta 1 día antes del inicio.</span>
            </div>
        </div>

        <!-- Orders Table / Management View -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden gear-card mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="rentalsTable">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4 py-3">Equipo Reservado</th>
                            <th class="py-3">Fechas & Duración</th>
                            <th class="py-3 text-center">Cantidad</th>
                            <th class="py-3">Total / Cobro</th>
                            <th class="py-3">Estado de Reserva</th>
                            <th class="py-3 text-end pe-4">Gestión de Cancelación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rental in rentalList)
                        {
                            var gearImg = EquipmentImageHelper.GetImageUrl(rental.EquipmentCategory, rental.EquipmentName);
                            bool canCancel = (rental.Status == "Pending" || rental.Status == "Approved") && today < rental.StartDate;
                            
                            string filterCategory = rental.Status switch
                            {
                                "Pending" or "Approved" => "active",
                                "Delivered" => "delivered",
                                "Returned" => "completed",
                                "Cancelled" or "Rejected" => "cancelled",
                                _ => "all"
                            };

                            var (badgeClass, badgeIcon, statusEs) = rental.Status switch
                            {
                                "Pending" => ("bg-warning text-dark", "bi-hourglass-split", "Pendiente"),
                                "Approved" => ("bg-primary text-white", "bi-check2-circle", "Aprobado"),
                                "Delivered" => ("bg-info text-dark", "bi-box-seam", "Entregado / En Uso"),
                                "Returned" => ("bg-success text-white", "bi-check-all", "Devuelto"),
                                "Rejected" => ("bg-danger text-white", "bi-x-circle", "Rechazado"),
                                "Cancelled" => ("bg-secondary text-white", "bi-slash-circle", "Cancelado"),
                                _ => ("bg-dark text-white", "bi-dot", rental.Status)
                            };

                            <tr class="rental-row" data-status="@filterCategory">
                                <!-- Equipment info -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@gearImg" alt="@rental.EquipmentName" class="rounded-3 shadow-sm border border-secondary border-opacity-25" style="width: 58px; height: 58px; object-fit: cover;" />
                                        <div>
                                            <div class="fw-bold text-body">@rental.EquipmentName</div>
                                            <div class="small text-muted d-flex align-items-center gap-2">
                                                <span class="badge bg-body-tertiary text-body border px-2 py-0">@rental.EquipmentCategory</span>
                                                <span>$@rental.DailyRate.ToString("F2")/día</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Dates -->
                                <td class="py-3">
                                    <div class="fw-semibold text-body">
                                        <i class="bi bi-calendar-event text-warning me-1"></i>
                                        @rental.StartDate.ToString("dd/MM/yyyy") &rarr; @rental.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="small text-muted mt-1 d-flex align-items-center gap-2">
                                        <span class="badge bg-body-secondary text-body border">@rental.TotalDays día(s)</span>
                                        @if (today < rental.StartDate)
                                        {
                                            var daysUntilStart = rental.StartDate.DayNumber - today.DayNumber;
                                            <span class="text-success small fw-semibold">Faltan @daysUntilStart día(s)</span>
                                        }
                                        else if (today <= rental.EndDate && (rental.Status == "Approved" || rental.Status == "Delivered"))
                                        {
                                            <span class="badge bg-info-subtle text-info border">En curso</span>
                                        }
                                    </div>
                                </td>

                                <!-- Quantity -->
                                <td class="py-3 text-center">
                                    <span class="badge bg-body-tertiary text-body border px-3 py-2 fw-bold">
                                        @rental.Quantity unidad@(rental.Quantity > 1 ? "es" : "")
                                    </span>
                                </td>

                                <!-- Costs -->
                                <td class="py-3">
                                    <div class="fw-bold fs-6 text-body">$@rental.TotalCost.ToString("F2")</div>
                                    @if (rental.LateFee > 0)
                                    {
                                        <div class="small text-danger fw-bold mt-1">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i>Recargo mora: +$@rental.LateFee.ToString("F2")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Sin recargos</div>
                                    }
                                </td>

                                <!-- Status Badge -->
                                <td class="py-3">
                                    <span class="badge @badgeClass rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-1 shadow-sm">
                                        <i class="bi @badgeIcon"></i> @statusEs
                                    </span>
                                    @if (rental.ActualReturnDate.HasValue)
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-arrow-return-left text-success me-1"></i>Devuelto el: @rental.ActualReturnDate.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                </td>

                                <!-- Cancellation Actions & Visual Indicators -->
                                <td class="text-end pe-4 py-3">
                                    @if (canCancel)
                                    {
                                        <div class="d-inline-flex flex-column align-items-end">
                                            <!-- Action Button for cancellation -->
                                            <button type="button" 
                                                    class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold trigger-cancel-btn shadow-sm"
                                                    data-rental-id="@rental.Id"
                                                    data-equipment-name="@rental.EquipmentName"
                                                    data-dates="@rental.StartDate.ToString("dd/MM/yyyy") al @rental.EndDate.ToString("dd/MM/yyyy")"
                                                    data-units="@rental.Quantity"
                                                    data-total="$@rental.TotalCost.ToString("F2")">
                                                <i class="bi bi-x-circle me-1"></i> Cancelar Pedido
                                            </button>
                                            <span class="text-success small mt-1 d-inline-flex align-items-center gap-1" style="font-size: 0.78rem;">
                                                <i class="bi bi-check-circle-fill"></i> Cancelable hasta @rental.StartDate.AddDays(-1).ToString("dd/MM/yyyy")
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Intuitive Non-cancelable Explanations -->
                                        @if (rental.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-slash-circle me-1"></i> Pedido Cancelado
                                            </span>
                                        }
                                        else if (rental.Status == "Delivered")
                                        {
                                            <span class="badge bg-info-subtle text-info border rounded-pill px-3 py-2 fw-semibold" title="El equipo ya fue entregado y se encuentra en producción">
                                                <i class="bi bi-camera-video-fill me-1"></i> En Rodaje
                                            </span>
                                        }
                                        else if (rental.Status == "Returned")
                                        {
                                            <span class="badge bg-success-subtle text-success border rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-patch-check-fill me-1"></i> Servicio Finalizado
                                            </span>
                                        }
                                        else if (rental.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border rounded-pill px-3 py-2 fw-semibold">
                                                <i class="bi bi-ban me-1"></i> No Procesable
                                            </span>
                                        }
                                        else
                                        {
                                            <!-- Pending or Approved, but StartDate is today or passed -->
                                            <div class="d-inline-flex flex-column align-items-end">
                                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 disabled" disabled>
                                                    <i class="bi bi-lock-fill me-1"></i> Cancelación Bloqueada
                                                </button>
                                                <span class="text-muted small mt-1" style="font-size: 0.75rem;">
                                                    <i class="bi bi-clock-history"></i> Plazo vencido (Fecha de inicio activa)
                                                </span>
                                            </div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Cancellation Policy Banner Card -->
        <div class="card border-0 shadow-sm rounded-4 p-4 gear-card">
            <div class="d-flex align-items-start gap-3">
                <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning flex-shrink-0">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1">Política Transparente de Cancelación</h6>
                    <p class="text-muted small mb-0 leading-relaxed">
                        En <strong>FrameRent</strong> entendemos que los planes de producción audiovisual pueden cambiar imprevistamente. Puedes cancelar cualquier reserva en estado <strong>Pendiente</strong> o <strong>Aprobada</strong> sin penalización alguna hasta el día previo a su fecha de inicio. Al cancelar, las unidades reservadas se liberan automáticamente en el inventario para otros cineastas.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<!-- Formulario Oculto para procesar la Cancelación con Token CSRF -->
<form id="hiddenCancelForm" asp-controller="Rentals" asp-action="Cancel" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="hiddenCancelRentalId" value="" />
</form>

<!-- Modal de Confirmación de Cancelación Mejorado -->
<div class="modal fade" id="customerCancelModal" tabindex="-1" aria-labelledby="customerCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-2xl p-2 gear-card">
            <div class="modal-header border-0 pb-0">
                <div class="p-2 rounded-circle bg-danger bg-opacity-10 text-danger me-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                </div>
                <div>
                    <h5 class="modal-title fw-bold" id="customerCancelModalLabel">¿Confirmar Cancelación de Pedido?</h5>
                    <div class="text-muted small">Esta acción liberará el equipo y cancelará la reserva.</div>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            
            <div class="modal-body py-3">
                <div class="p-3 rounded-3 bg-body-tertiary border mb-3">
                    <div class="row g-2">
                        <div class="col-12">
                            <span class="text-muted small">Equipo:</span>
                            <div class="fw-bold fs-6 text-body" id="modalEquipName"></div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small">Fechas de Rodaje:</span>
                            <div class="fw-semibold text-body" id="modalRentalDates"></div>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small">Unidades / Costo:</span>
                            <div class="fw-semibold text-body" id="modalUnitsAndCost"></div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning border-0 rounded-3 py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-info-circle-fill fs-6 text-warning"></i>
                    <div>Una vez cancelado, no podrás revertir esta acción. Tendrás que solicitar una nueva reserva si lo necesitas de nuevo.</div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 btn-sm fw-semibold" data-bs-dismiss="modal">
                    Conservar Pedido
                </button>
                <button type="button" class="btn btn-danger rounded-pill px-4 btn-sm fw-bold shadow-sm" id="confirmCustomerCancelBtn">
                    <i class="bi bi-x-circle me-1"></i> Sí, Cancelar Definitivamente
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Interactive Filter Buttons
        const filterBtns = document.querySelectorAll('#rentalFilterGroup .filter-btn');
        const rows = document.querySelectorAll('.rental-row');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('active', 'btn-warning', 'text-dark'));
                btn.classList.add('active');

                const filter = btn.getAttribute('data-filter');

                rows.forEach(row => {
                    const status = row.getAttribute('data-status');
                    if (filter === 'all' || status === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });

        // 2. Cancellation Modal Trigger & Data Binding
        const modalElement = document.getElementById('customerCancelModal');
        const bsModal = modalElement ? new bootstrap.Modal(modalElement) : null;
        const hiddenForm = document.getElementById('hiddenCancelForm');
        const hiddenInputId = document.getElementById('hiddenCancelRentalId');

        const modalEquip = document.getElementById('modalEquipName');
        const modalDates = document.getElementById('modalRentalDates');
        const modalUnitsCost = document.getElementById('modalUnitsAndCost');
        const confirmBtn = document.getElementById('confirmCustomerCancelBtn');

        document.querySelectorAll('.trigger-cancel-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const rentalId = btn.getAttribute('data-rental-id');
                const equipName = btn.getAttribute('data-equipment-name');
                const dates = btn.getAttribute('data-dates');
                const units = btn.getAttribute('data-units');
                const total = btn.getAttribute('data-total');

                if (hiddenInputId) hiddenInputId.value = rentalId;
                if (modalEquip) modalEquip.textContent = equipName;
                if (modalDates) modalDates.textContent = dates;
                if (modalUnitsCost) modalUnitsCost.textContent = `${units} unidad(es) &bull; ${total}`;

                if (bsModal) {
                    bsModal.show();
                }
            });
        });

        if (confirmBtn && hiddenForm) {
            confirmBtn.addEventListener('click', () => {
                const loader = document.getElementById('page-loader-overlay');
                if (loader) loader.classList.add('active');
                if (bsModal) bsModal.hide();
                hiddenForm.submit();
            });
        }
    });
</script>
