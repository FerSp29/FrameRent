<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FrameRent</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <script>
        // Set initial theme before body renders to avoid flickering
        (function() {
            const savedTheme = localStorage.getItem('framerent-theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <style>
        :root {
            --primary-accent: #f59e0b;
            --primary-accent-hover: #d97706;
        }

        /* Light Theme Palette & Background */
        [data-bs-theme="light"] {
            --site-bg: #f1f5f9;
            --site-bg-pattern: radial-gradient(circle at top right, rgba(245, 158, 11, 0.08) 0%, transparent 40%),
                               radial-gradient(circle at bottom left, rgba(59, 130, 246, 0.06) 0%, transparent 40%),
                               #f8fafc;
            --navbar-bg: rgba(255, 255, 255, 0.85);
            --navbar-border: rgba(226, 232, 240, 0.8);
            --card-surface: #ffffff;
            --card-border: #e2e8f0;
            --text-heading: #0f172a;
            --text-body: #334155;
            --footer-bg: #0f172a;
            --footer-text: #94a3b8;
        }

        /* Dark Theme Palette & Background */
        [data-bs-theme="dark"] {
            --site-bg: #090d16;
            --site-bg-pattern: radial-gradient(circle at 10% 20%, rgba(245, 158, 11, 0.07) 0%, transparent 35%),
                               radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.08) 0%, transparent 35%),
                               linear-gradient(180deg, #070a12 0%, #0d1322 100%);
            --navbar-bg: rgba(11, 17, 32, 0.85);
            --navbar-border: rgba(255, 255, 255, 0.08);
            --card-surface: #111827;
            --card-border: rgba(255, 255, 255, 0.08);
            --text-heading: #f8fafc;
            --text-body: #cbd5e1;
            --footer-bg: #050811;
            --footer-text: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--site-bg-pattern);
            background-attachment: fixed;
            color: var(--text-body);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Film & Cinema Themed Dynamic Loader Overlay */
        #page-loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(7, 10, 18, 0.88);
            backdrop-filter: blur(6px);
            z-index: 99999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.18s ease, visibility 0.18s ease;
        }

        #page-loader-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .cinema-reel-loader {
            width: 64px;
            height: 64px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cinema-reel-spinner {
            width: 100%;
            height: 100%;
            border: 3.5px dashed var(--primary-accent);
            border-radius: 50%;
            animation: reelSpin 0.75s linear infinite;
        }

        .cinema-reel-icon {
            position: absolute;
            font-size: 1.5rem;
            color: var(--primary-accent);
            animation: pulseGlow 1.2s ease-in-out infinite alternate;
        }

        @@keyframes reelSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @@keyframes pulseGlow {
            0% { transform: scale(0.9); opacity: 0.75; }
            100% { transform: scale(1.1); opacity: 1; filter: drop-shadow(0 0 10px rgba(245,158,11,0.6)); }
        }

        /* Navbar Styling */
        .navbar-custom {
            background-color: var(--navbar-bg);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--navbar-border);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.6px;
            font-size: 1.35rem;
        }

        .nav-link {
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

        .nav-link:hover {
            color: var(--primary-accent) !important;
        }

        /* Theme Toggle Button */
        .theme-toggle-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #f8fafc;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        [data-bs-theme="light"] .theme-toggle-btn {
            background: #e2e8f0;
            border-color: #cbd5e1;
            color: #0f172a;
        }

        .theme-toggle-btn:hover {
            transform: rotate(20deg) scale(1.08);
            background: var(--primary-accent);
            color: #0f172a;
            border-color: var(--primary-accent);
        }

        /* Cards & Visual Polish */
        .gear-card {
            background: var(--card-surface);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            overflow: hidden;
            transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .gear-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 32px rgba(0, 0, 0, 0.15);
            border-color: var(--primary-accent);
        }

        .gear-img-wrap {
            position: relative;
            height: 220px;
            overflow: hidden;
            background: #0b1120;
        }

        .gear-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .gear-card:hover .gear-img-wrap img {
            transform: scale(1.06);
        }

        .badge-category {
            position: absolute;
            top: 14px;
            left: 14px;
            backdrop-filter: blur(8px);
            background: rgba(15, 23, 42, 0.85);
            color: #f8fafc;
            font-weight: 600;
            font-size: 0.75rem;
            padding: 5px 12px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-rent {
            background-color: var(--primary-accent);
            color: #0f172a;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .btn-rent:hover {
            background-color: var(--primary-accent-hover);
            color: #ffffff;
            transform: translateY(-1px);
        }

        footer {
            margin-top: auto;
            background-color: var(--footer-bg);
            color: var(--footer-text);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>
    <!-- Film & Cinema Themed Dynamic Page Loader Overlay -->
    <div id="page-loader-overlay">
        <div class="cinema-reel-loader mb-3">
            <div class="cinema-reel-spinner"></div>
            <i class="bi bi-camera-reels-fill cinema-reel-icon"></i>
        </div>
        <div class="d-flex align-items-center gap-2 text-warning fw-bold fs-5">
            <span>FrameRent</span>
        </div>
        <span class="text-white-50 small mt-1">Loading experience...</span>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top py-3">
        <div class="container-fluid px-4 px-lg-5">
            <a class="navbar-brand d-flex align-items-center gap-2 text-body page-link-trigger" asp-controller="Catalog" asp-action="Index">
                <span class="p-1 rounded-3 bg-warning text-dark d-flex align-items-center justify-content-center shadow-sm" style="width: 34px; height: 34px;">
                    <i class="bi bi-camera-reels-fill fs-5"></i>
                </span>
                <span class="fw-bold tracking-tight">FrameRent</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ps-lg-3">
                    <li class="nav-item">
                        <a class="nav-link page-link-trigger d-flex align-items-center gap-1" asp-controller="Catalog" asp-action="Index">
                            <i class="bi bi-grid-fill text-warning"></i> Catalog
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Customer))
                    {
                        <li class="nav-item">
                            <a class="nav-link page-link-trigger d-flex align-items-center gap-1" asp-controller="Rentals" asp-action="MyRentals">
                                <i class="bi bi-calendar-check-fill text-warning"></i> My Rentals
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    <!-- Light / Dark Mode Toggle Button -->
                    <li class="nav-item">
                        <button type="button" class="theme-toggle-btn shadow-sm" id="themeToggleBtn" title="Toggle Light / Dark Mode">
                            <i class="bi bi-sun-fill" id="themeIconSun" style="display: none;"></i>
                            <i class="bi bi-moon-stars-fill" id="themeIconMoon"></i>
                        </button>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item text-body small d-flex align-items-center gap-2">
                            <span class="text-muted">Hello,</span>
                            <span class="fw-bold">@User.Identity.Name</span>
                            @if (User.IsInRole(Roles.Staff))
                            {
                                <span class="badge bg-warning text-dark fw-bold">Staff</span>
                            }
                            else
                            {
                                <span class="badge bg-primary text-white fw-bold">Customer</span>
                            }
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 page-link-trigger" asp-controller="Account" asp-action="Login">
                                Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-bold rounded-pill px-3 page-link-trigger text-dark shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus-fill me-1"></i> Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Flow (Landing pages stretch full width, Catalog & Details stay responsive) -->
    <main class="flex-grow-1">
        <div class="container-fluid px-4 px-lg-5 pt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="py-4 mt-5">
        <div class="container-fluid px-4 px-lg-5 d-flex flex-wrap justify-content-between align-items-center text-sm">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-camera-reels-fill text-warning fs-5"></i>
                <span class="fw-bold text-white">FrameRent</span>
                <span class="text-white-50 ms-2 d-none d-md-inline">&mdash; Professional Audiovisual Equipment Rental Platform</span>
            </div>
            <div class="small mt-2 mt-md-0 text-white-50">
                Crafted for Filmmakers, Creators & Producers &bull; @DateTime.UtcNow.Year
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Light / Dark Mode Toggle Logic
        (function() {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const sunIcon = document.getElementById('themeIconSun');
            const moonIcon = document.getElementById('themeIconMoon');

            const updateIcons = (theme) => {
                if (theme === 'light') {
                    sunIcon.style.display = 'none';
                    moonIcon.style.display = 'inline-block';
                } else {
                    sunIcon.style.display = 'inline-block';
                    moonIcon.style.display = 'none';
                }
            };

            const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'dark';
            updateIcons(currentTheme);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    const activeTheme = document.documentElement.getAttribute('data-bs-theme');
                    const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-bs-theme', newTheme);
                    localStorage.setItem('framerent-theme', newTheme);
                    updateIcons(newTheme);
                });
            }
        })();

        // Dynamic loading icon when navigating between sections/pages, reloading, or submitting forms
        document.addEventListener('DOMContentLoaded', () => {
            const loader = document.getElementById('page-loader-overlay');

            // Quick smooth dismiss on initial page load / render
            if (loader) {
                setTimeout(() => {
                    loader.classList.remove('active');
                }, 140);
            }

            const showLoader = () => {
                if (loader) {
                    loader.classList.add('active');
                    // Safety auto-dismiss in case of network cancellation
                    setTimeout(() => {
                        loader.classList.remove('active');
                    }, 4000);
                }
            };

            // Trigger loader on page reload or unload
            window.addEventListener('beforeunload', () => {
                showLoader();
            });

            // Trigger loader on internal link navigation (catalog, details, checkout, auth, rentals)
            document.querySelectorAll('a[href]:not([href^="#"]):not([href^="javascript"]):not([target="_blank"])').forEach(link => {
                link.addEventListener('click', (e) => {
                    if (!e.ctrlKey && !e.shiftKey && !e.metaKey && !e.defaultPrevented) {
                        showLoader();
                    }
                });
            });

            // Trigger loader on forms submission (login, register, checkout booking, cancel, filters)
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', () => {
                    showLoader();
                });
            });

            // Hide loader if back/forward button used from cache
            window.addEventListener('pageshow', (event) => {
                if (loader) {
                    loader.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>
