<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FrameRent</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-accent: #f59e0b;
            --primary-dark: #0f172a;
            --surface-bg: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--surface-bg);
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Progress Bar & Dynamic Loader Overlay */
        #page-loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(5px);
            z-index: 99999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        #page-loader-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .loader-spinner {
            width: 65px;
            height: 65px;
            border: 4px solid rgba(245, 158, 11, 0.2);
            border-top: 4px solid var(--primary-accent);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Navbar Styling */
        .navbar-custom {
            background-color: #0b1120;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -0.6px;
            font-size: 1.35rem;
        }

        .nav-link {
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

        .nav-link:hover {
            color: var(--primary-accent) !important;
        }

        /* Cards & Visual Polish */
        .gear-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .gear-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
            border-color: #cbd5e1;
        }

        .gear-img-wrap {
            position: relative;
            height: 210px;
            overflow: hidden;
            background: #0f172a;
        }

        .gear-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .gear-card:hover .gear-img-wrap img {
            transform: scale(1.06);
        }

        .badge-category {
            position: absolute;
            top: 14px;
            left: 14px;
            backdrop-filter: blur(8px);
            background: rgba(15, 23, 42, 0.8);
            color: #f8fafc;
            font-weight: 600;
            font-size: 0.75rem;
            padding: 5px 12px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-rent {
            background-color: var(--primary-accent);
            color: #0f172a;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

        .btn-rent:hover {
            background-color: #d97706;
            color: #ffffff;
            transform: translateY(-1px);
        }

        footer {
            margin-top: auto;
            background-color: #0b1120;
            color: #94a3b8;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>
    <!-- Dynamic Page Loader Overlay -->
    <div id="page-loader-overlay">
        <div class="loader-spinner mb-3"></div>
        <div class="d-flex align-items-center gap-2 text-warning fw-bold fs-5">
            <i class="bi bi-camera-reels"></i> FrameRent
        </div>
        <span class="text-white-50 small mt-1">Loading experience...</span>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 text-white page-link-trigger" asp-controller="Catalog" asp-action="Index">
                <span class="p-1 rounded-3 bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="bi bi-camera-reels-fill fs-5"></i>
                </span>
                FrameRent
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ps-lg-3">
                    <li class="nav-item">
                        <a class="nav-link text-white-50 page-link-trigger" asp-controller="Catalog" asp-action="Index">
                            <i class="bi bi-grid-fill me-1 text-warning"></i> Catalog
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Customer))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white-50 page-link-trigger" asp-controller="Rentals" asp-action="MyRentals">
                                <i class="bi bi-calendar-check-fill me-1 text-warning"></i> My Rentals
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-2 text-light small d-flex align-items-center gap-2">
                            <span class="text-white-50">Hello,</span>
                            <span class="fw-bold text-white">@User.Identity.Name</span>
                            @if (User.IsInRole(Roles.Staff))
                            {
                                <span class="badge bg-warning text-dark fw-bold">Staff</span>
                            }
                            else
                            {
                                <span class="badge bg-primary text-white fw-bold">Customer</span>
                            }
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3 page-link-trigger" asp-controller="Account" asp-action="Login">
                                Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-bold rounded-pill px-3 page-link-trigger text-dark" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus-fill me-1"></i> Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Body Container -->
    <main class="py-4 flex-grow-1">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-4">
        <div class="container d-flex flex-wrap justify-content-between align-items-center text-sm">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-camera-reels-fill text-warning"></i>
                <span class="text-white fw-bold">FrameRent</span>
                <span class="text-muted ms-2">&mdash; Professional Audiovisual Equipment Rental Platform</span>
            </div>
            <div class="text-muted small mt-2 mt-md-0">
                Crafted for Filmmakers, Creators & Producers &bull; @DateTime.UtcNow.Year
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Dynamic loading icon when navigating between sections/pages or submitting forms
        document.addEventListener('DOMContentLoaded', () => {
            const loader = document.getElementById('page-loader-overlay');

            const showLoader = () => {
                if (loader) loader.classList.add('active');
            };

            // Trigger loader on links with page-link-trigger or internal navigation
            document.querySelectorAll('a[href]:not([href^="#"]):not([target="_blank"])').forEach(link => {
                link.addEventListener('click', (e) => {
                    if (!e.ctrlKey && !e.shiftKey && !e.metaKey && !e.defaultPrevented) {
                        showLoader();
                    }
                });
            });

            // Trigger loader on forms submission
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', () => {
                    showLoader();
                });
            });

            // Hide loader if back/forward button used from cache
            window.addEventListener('pageshow', (event) => {
                if (event.persisted && loader) {
                    loader.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>
